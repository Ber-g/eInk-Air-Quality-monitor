# GABARIT — ne pas copier tel quel dans /etc/systemd/system/.
# `install.sh` y substitue __AIRQ_USER__ et __AIRQ_DIR__ : systemd ne sait pas
# interpoler une variable d'environnement dans User= ni WorkingDirectory=.
[Unit]
Description=AirQualityInk — moniteur qualité de l'air
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
User=__AIRQ_USER__
SupplementaryGroups=video
WorkingDirectory=__AIRQ_DIR__
Environment=SDL_VIDEODRIVER=fbcon
Environment=SDL_FBDEV=/dev/fb0
Environment=AQI_FULLSCREEN=1
ExecStartPre=+/usr/bin/chvt 1
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=10
# 500M : ffmpeg decode les videos du mode Musee dans ce meme cgroup.
# A 200M il etait tue en pleine lecture, l'app restant sous les 80M.
MemoryMax=500M
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYVTDisallocate=yes
TTYReset=yes

[Install]
WantedBy=multi-user.target
