[Unit]
Description=AirQualityInk — moniteur qualité de l'air
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
User=pi
SupplementaryGroups=video
WorkingDirectory=/home/pi/Documents/AirQ
Environment=SDL_VIDEODRIVER=fbcon
Environment=SDL_FBDEV=/dev/fb0
Environment=AQI_FULLSCREEN=1
ExecStartPre=+/usr/bin/chvt 1
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=10
# 500M : ffmpeg decode les videos du mode Musee dans ce meme cgroup.
# A 200M il etait tue en pleine lecture, l'app restant sous les 80M.
MemoryMax=500M
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYVTDisallocate=yes
TTYReset=yes

[Install]
WantedBy=multi-user.target
